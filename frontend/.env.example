VITE_API_BASE_URL=http://localhost:8080/api/v1

# Clerk is optional for local hacking.
# Add this from Clerk Dashboard -> API keys to enable sign-in/sign-up and UserButton.
VITE_CLERK_PUBLISHABLE_KEY=

# Used only when Clerk is disabled. With Clerk enabled, the backend derives a stable
# private Mizaaj user id from the signed-in Clerk subject.
VITE_USER_ID=00000000-0000-4000-8000-000000000001
