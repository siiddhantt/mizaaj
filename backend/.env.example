ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://192.168.1.9:5173"]

DATABASE_URL=postgresql+psycopg://mizaaj:mizaaj@localhost:5432/mizaaj
STORE_PROVIDER=postgres

UPLOAD_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/mizaaj-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mizaaj
S3_SECRET_ACCESS_KEY=mizaaj-secret
S3_BUCKET=mizaaj-uploads

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VISION_MODEL=qwen/qwen3.7-plus

MEMORY_PROVIDER=cognee_local
COGNEE_DATASET_PREFIX=mizaaj_user
COGNEE_LLM_PROVIDER=custom
COGNEE_LLM_MODEL=deepseek/deepseek-v4-flash
COGNEE_LLM_ENDPOINT=https://openrouter.ai/api/v1
COGNEE_LLM_API_KEY=
COGNEE_EMBEDDING_PROVIDER=fastembed
COGNEE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COGNEE_EMBEDDING_DIMENSIONS=384

# Clerk is optional in local dev. For account-based demo mode:
# 1. Set VITE_CLERK_PUBLISHABLE_KEY in the frontend.
# 2. Set AUTH_REQUIRED=true here.
# 3. Copy the Clerk issuer/frontend API URL from Dashboard -> API keys.
# 4. Set CLERK_JWKS_URL to that frontend API URL plus "/.well-known/jwks.json".
# The API maps each Clerk subject to a stable internal UUID, preserving existing
# per-user database, S3, and Cognee dataset isolation.
AUTH_REQUIRED=false
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
